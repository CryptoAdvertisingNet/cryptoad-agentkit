  },
  "devDependencies": {
    "@coinbase/agentkit": "0.10.4",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CryptoAdvertisingNet/cryptoad-agentkit.git"
  }
